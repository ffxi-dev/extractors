#!/bin/sh
# parity [check|ref|baseline] <unit>... [--captures sample|all|<id>,<id>] [-j N] [--rows N] [--against <tag>]
# Runs parity.py on lsb, in its image, over this checkout's files as they are now. README.md says more.
set -eu
host=${PARITY_HOST:-sruon@192.168.1.218}
data=${PARITY_DATA:-/home/sruon/scholar-data}
releases=${PARITY_RELEASES:-/home/sruon/parity-release}
cmd=check
case "${1:-}" in check | ref | baseline) cmd=$1 && shift ;; esac
against= prev=
for a; do [ "$prev" = --against ] && against=$a; prev=$a; done
cd "$(git rev-parse --show-toplevel)"
work=/tmp/parity-$(date +%s)-$$
git ls-files -co --exclude-standard | tar --ignore-failed-read -czf - -T - 2>/dev/null |
    ssh "$host" "mkdir -p $work && tar -xzf - -C $work"
[ -z "$against" ] || git archive "$against" | ssh "$host" "mkdir -p $work/against && tar -xf - -C $work/against"
ssh "$host" sh -s <<SH
set -e
img= rel=
trap 'rm -rf $work; for i in \$img \$rel; do docker rmi -f "\$i" >/dev/null; done' EXIT
img=\$(docker build -q -f $work/rust/parity/Dockerfile $work)
mkdir -p $data/parity-ref $releases
run() { docker run --rm --user "\$(id -u):\$(id -g)" -e PARITY_RUST=${PARITY_RUST:-} -v $data/mirror:/mirror:ro \
    -v $data/parity-ref:/ref -v $releases:/release -v $work/rust/parity:/parity:ro "\$@"; }
if [ -n "$against" ]; then
    # The release's rows, by this checkout's parity.py in the release's image. The tag's files carry its
    # commit's times, older than the builds in the shared target cache, which cargo would take for the tag's:
    # the release builds without it.
    rel=\$(sed 's| --mount=type=cache,target=/cargo/target||' $work/rust/parity/Dockerfile |
        docker build -q -f - $work/against)
    run \$rel python /parity/parity.py ref $*
    [ $cmd = ref ] && exit
fi
run \$img python /parity/parity.py $cmd $*
SH
